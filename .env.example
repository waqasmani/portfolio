# Local development environment — never commit real secrets.
DATABASE_URL="postgresql://portfolio:YOUR_DB_PASSWORD@localhost:5432/portfolio"

# 32+ char random string used to sign/derive session material.
SESSION_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# Public origin of the site (used for SEO, sitemaps, canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"  # production: https://customerflow.work

# Credentials for the initial admin user created by `prisma db seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHOOSE_A_STRONG_PASSWORD"

# Optional: enables the AI Project Assistant + offline chat assistant via the
# Claude API. Without it, a built-in heuristic engine is used instead.
ANTHROPIC_API_KEY=""

# Optional: S3-compatible object storage (Cloudflare R2) for file uploads.
# Falls back to metadata-only attachments when unset.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
